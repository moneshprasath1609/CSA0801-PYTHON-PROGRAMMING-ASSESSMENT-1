from datetime import datetime, timedelta
import random, time, csv, sqlite3
import pandas as pd

def make_data(station_count):
    rows = []
    start = datetime(2026, 1, 1)

    for s in range(station_count):
        for i in range(8760):
            dt = start + timedelta(hours=i)
            rows.append((
                f"S{s:03}",
                dt.strftime("%Y-%m-%d"),
                dt.hour,
                round(random.uniform(5, 180), 2)
            ))

    return rows

def timed(label, fn):
    t0 = time.perf_counter()
    result = fn()
    print(label, "seconds:", round(time.perf_counter()-t0, 4))
    return result

for count in (1, 12, 120):
    rows = make_data(count)

    # Loop method
    def loop_method():
        totals = {}

        for station, day, hour, pm in rows:
            key = (station, day)
            total, n = totals.get(key, (0.0, 0))
            totals[key] = (total + pm, n + 1)

        return {
            k: total/n for k, (total, n) in totals.items()
        }

    timed("Python loops", loop_method)

    # pandas method
    def pandas_method():
        frame = pd.DataFrame(rows, columns=[
            "station", "date", "hour", "pm25"
        ])

        return frame.groupby(
            ["station", "date"]
        )["pm25"].mean()

    timed("pandas", pandas_method)

    # SQL method
    def sql_method():
        db = sqlite3.connect(":memory:")

        db.execute(
            "CREATE TABLE aq(station TEXT, day TEXT, hour INT, pm25 REAL)"
        )

        db.executemany(
            "INSERT INTO aq VALUES(?,?,?,?)", rows
        )

        result = db.execute(
            "SELECT station, day, AVG(pm25) FROM aq GROUP BY station, day"
        ).fetchall()

        db.close()
        return result

    timed("SQLite", sql_method)
import cProfile

cProfile.run("loop_method()", sort="cumtime")
POSITIVE = {"good", "clean", "fast", "helpful", "improved"}
NEGATIVE = {"bad", "dirty", "slow", "rude", "smoke", "broken"}
NEGATORS = {"not", "never", "no"}

def score(text):
    words = text.lower().replace(".", " ").replace(",", " ").split()
    total = 0

    for i, word in enumerate(words):
        value = 1 if word in POSITIVE else -1 if word in NEGATIVE else 0

        if i > 0 and words[i-1] in NEGATORS:
            value = -value

        total += value

    return total

def label(text):
    s = score(text)
    return "positive" if s > 0 else "negative" if s < 0 else "neutral"

for c in [
    "Roads are clean and the bus was fast.",
    "Smoke from the factory, air is bad.",
    "The staff were not helpful.",
    "Not bad, service improved."
]:
    print(f"{label(c):8} | {c}")
import re
from collections import Counter

STOP = {
    "the", "a", "an", "is", "are", "was", "were", "and",
    "or", "to", "of", "in", "on", "from", "it", "this", "that"
}

def summarise(text, k=2):
    sentences = re.split(r'(?<=[.!?])\s+', text.strip())

    words = re.findall(r"[a-zA-Z]+", text.lower())

    important = [w for w in words if w not in STOP]
    freq = Counter(important)

    scored = []

    for index, sentence in enumerate(sentences):
        tokens = re.findall(r"[a-zA-Z]+", sentence.lower())
        value = sum(freq[w] for w in tokens if w not in STOP)
        scored.append((value, index, sentence))

    chosen = sorted(scored, key=lambda x: (-x[0], x[1]))[:k]

    return " ".join(
        x[2] for x in sorted(chosen, key=lambda x: x[1])
    )
